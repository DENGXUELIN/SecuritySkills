            "sts:AssumeRole"
          ],
          "resources": [
            "arn:aws:iam::123456789012:role/prod-admin",
            "arn:aws:iam::123456789012:role/*"
          ]
        }
      ],
      "boundary_evidence": {
        "permission_boundary": null,
        "deny_policy": null,
        "approval_ticket": null
      },
      "expected_findings": [
        {
          "id": "PAM-EFFPRIV-03",
          "severity": "high",
          "reason": "automation principal can pass or assume privileged roles without PAM or JIT evidence"
        },
        {
          "id": "PAM-EFFPRIV-04",
          "severity": "high",
          "reason": "automation can modify privileged role policy outside an approval-gated workflow"
        }
      ]
