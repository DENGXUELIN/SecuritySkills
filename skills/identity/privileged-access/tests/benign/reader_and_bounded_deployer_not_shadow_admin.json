{
  "scenario": "reader-and-bounded-deployer-not-shadow-admin",
  "skill": "privileged-access",
  "expected_skill_version": "1.0.1",
  "cases": [
    {
      "platform": "azure",
      "evidence_type": "role_assignment_export",
      "principal": {
        "name": "secops-audit-readers",
        "type": "group"
      },
      "role_assignments": [
        {
          "role": "Security Reader",
          "scope": "/providers/Microsoft.Management/managementGroups/prod",
          "allowed_actions": [
            "Microsoft.Security/*/read",
            "Microsoft.Authorization/roleAssignments/read"
          ],
          "denied_actions": [
            "Microsoft.Authorization/roleAssignments/write",
            "Microsoft.Authorization/elevateAccess/action"
          ]
        }
      ],
      "effective_capabilities": {
        "can_modify_privileged_identity": false,
        "can_reset_mfa_or_credentials": false,
        "can_assume_admin_role": false
      },
      "expected_status": "pass",
      "false_positive_guardrail": "read-only security roles should not be reported as shadow admins without write, reset, assume, or approve capability"
    },
    {
      "platform": "aws",
      "evidence_type": "iam_policy_and_change_ticket",
      "principal": {
        "type": "automation_principal",
        "name": "github-actions-service-deployer",
        "pam_onboarded": true,
        "jit_required": true
      },
      "policy_statements": [
        {
          "effect": "Allow",
          "actions": [
            "ecs:UpdateService",
            "codedeploy:CreateDeployment"
          ],
          "resources": [
            "arn:aws:ecs:us-east-1:123456789012:service/prod/*"
          ]
        }
      ],
      "boundary_evidence": {
        "denies": [
          "iam:*",
          "sts:AssumeRole",
          "organizations:*"
        ],
        "change_ticket": "CHG-2026-0612",
        "expires_at": "2026-06-09T12:00:00Z"
      },
      "effective_capabilities": {
        "can_modify_privileged_identity": false,
        "can_administer_control_plane": false
      },
      "expected_status": "pass",
      "false_positive_guardrail": "deployment automation is not a shadow-admin finding when boundary evidence proves it cannot alter identity or administrative control planes"
    }
  ]
}
