{
  "principal": "arn:aws:iam::111122223333:user/developer",
  "attachedPolicies": [
    {
      "policyName": "DeveloperPassBuildRolesOnly",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::111122223333:role/build-*",
            "Condition": {
              "StringEquals": {
                "iam:PassedToService": "codebuild.amazonaws.com"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "codebuild:StartBuild",
              "codebuild:BatchGetBuilds"
            ],
            "Resource": "arn:aws:codebuild:us-east-1:111122223333:project/ci-*"
          }
        ]
      }
    }
  ],
  "guardrails": [
    "PassRole is scoped to build-* roles",
    "iam:PassedToService restricts use to CodeBuild",
    "build roles have permissions boundaries that deny iam:* and sts:AssumeRole"
  ],
  "expectedResult": "Do not report IAM-PRIV-10 unless additional evidence shows the build-* roles can reach privileged resources or bypass the permissions boundary."
}
