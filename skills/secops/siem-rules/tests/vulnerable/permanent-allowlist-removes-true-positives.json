    "owner": null,
    "detection_owner": null,
    "ticket": null,
    "rationale": "reduce alert noise",
    "expiry": null,
    "review_cadence": null
  },
  "regression": {
    "known_true_positive_replay": "failed",
    "before_count": 12,
    "after_count": 0,
    "residual_coverage": null
  },
  "expected_findings": [
    {
      "gate": "SIEM-SUP-02",
      "reason": "No owner, detection owner, ticket, rationale review, or approval authority is recorded."
    },
    {
      "gate": "SIEM-SUP-03",
      "reason": "Suppression scope is effectively global and removes the target population."
    },
    {
      "gate": "SIEM-SUP-04",
      "reason": "Permanent suppression has no expiry or review cadence."
