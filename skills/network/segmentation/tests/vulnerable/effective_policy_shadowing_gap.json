            "app": "api"
          },
          "ingressDeny": [
            {
              "fromEndpoints": {
                "zone": "untrusted"
              }
            }
          ]
        },
        {
          "kind": "CiliumNetworkPolicy",
          "name": "allow-frontend-to-api",
          "endpointSelector": {
            "app": "api"
          },
          "ingress": [
            {
              "fromEndpoints": {
                "role": "frontend"
              }
            }
          ]
        }
      ]
    }
  ],
  "runtime_evidence": {
