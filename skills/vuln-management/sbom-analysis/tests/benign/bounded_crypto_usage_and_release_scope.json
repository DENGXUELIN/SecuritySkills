{
  "scenario": "bounded-crypto-usage-and-release-scope",
  "skill": "sbom-analysis",
  "expected_skill_version": "1.0.1",
  "cases": [
    {
      "artifact_type": "sbom-plus-protocol-config",
      "components": [
        {
          "name": "openssl",
          "version": "3.2.1",
          "purl": "pkg:generic/openssl@3.2.1"
        }
      ],
      "crypto_usage_evidence": {
        "component_binding": "api-gateway",
        "protocols": [
          "TLS 1.3"
        ],
        "cipher_suites": [
          "TLS_AES_256_GCM_SHA384",
          "TLS_CHACHA20_POLY1305_SHA256"
        ],
        "disabled_algorithms": [
          "MD5",
          "SHA1 signatures",
          "RSA key exchange",
          "TLS 1.0",
          "TLS 1.1"
        ]
      },
      "expected_status": "pass",
      "false_positive_guardrail": "general-purpose crypto library presence is not proof that every algorithm in the library is used"
    },
    {
      "artifact_type": "cyclonedx-sbom",
      "components": [
        {
          "name": "integration-test-fixtures",
          "scope": "excluded-from-release",
          "crypto_assets": [
            {
              "asset": "localhost-test-cert",
              "type": "certificate",
              "algorithm": "sha1WithRSAEncryption",
              "key_length": 1024,
              "component_binding": "test-harness",
              "owner": "qa",
              "expires_at": "2030-01-01T00:00:00Z"
            }
          ]
        }
      ],
      "release_evidence": {
        "production_artifact_manifest_excludes": [
          "integration-test-fixtures"
        ],
        "ci_policy_blocks_test_materials_in_release": true
      },
      "expected_status": "pass",
      "false_positive_guardrail": "development-only test certificates should not be production crypto findings when scope evidence proves they are excluded from released artifacts"
    }
  ]
}
